<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.woohak.randomtd"
    android:versionCode="10"
    android:versionName="0.1.9">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35" />
    <!-- 앱 안 업데이트 (U-1): 자바(Updater)가 GitHub 릴리스를 HTTPS로 확인·받는다. WebView는 APK 안 파일만 연다 (GameActivity.GameAssets) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 받은 새 버전 APK를 PackageInstaller로 설치 (사용자가 '출처를 알 수 없는 앱 설치'를 허용하고 시스템 확인 창에서 누름) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- allowBackup="true": 자동 저장·전투 기록·설정은 WebView localStorage에 있다 — 기기 백업·새 기기 복원에 일부러 포함한다 (A-1b) -->
    <application
        android:allowBackup="true"
        android:label="운빨 디펜스"
        android:enableOnBackInvokedCallback="true"
        android:icon="@drawable/game_icon"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:usesCleartextTraffic="false"
        android:hardwareAccelerated="true">
        <activity
            android:name=".GameActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- PackageInstaller 세션 결과 (Updater의 명시적 PendingIntent로만 옴) -->
        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />
    </application>
</manifest>
